{
  "servers": {
    "playwright-test": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "playwright",
        "run-test-mcp-server"
      ]
    },
    "postman": {
      "type": "http",
      "url": "https://mcp.postman.com/minimal",
      "headers": { "Authorization": "Bearer ${input:postman-api-key}" }
    }
  },
  "inputs": [
    {
    "id": "postman-api-key",
    "type": "promptString",
    "description": "Enter your Postman API key"
  }
  ]
}